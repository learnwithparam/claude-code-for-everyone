{
  "permissions": {
    "defaultMode": "default",
    "blockWritesOutsideWorkingDirectories": true,
    "deny": [
      "Read(../checks/**)",
      "Edit(./till/**)",
      "Edit(./purchase-orders/**)",
      "Bash(rm *)",
      "Read(./private/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-originals.ts\""
          }
        ]
      }
    ]
  }
}
